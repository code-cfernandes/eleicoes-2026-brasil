# Ambiente: "oficial" (eleição real) ou "simulado/simulado2026" (testes do TSE)
TSE_BASE=https://resultados.tse.jus.br/oficial
CICLO=ele2026
# Códigos da eleição (1º turno 2026): descubra/atualize com `npm run eleicoes`
ELEICAO_FEDERAL=6257
ELEICAO_ESTADUAL=6259
CACHE_SEGUNDOS=30
PORT=3000
# Histórico: disputas coletadas em background, mesmo sem ninguém na tela.
# Formato uf:cargo; "*" vale todos. Cargos: 1 presidente, 3 governador, 5 senador,
# 6 dep. federal, 7 dep. estadual, 8 dep. distrital.
# Ex.: br:1,*:3,*:5 (presidente BR + governador e senador de todas as UFs)
#      sp:*         (todos os cargos de SP)
MONITORAR=br:1
TURNO=1º turno
# Banco SQLite do histórico (no Docker é sempre /app/data/eleicoes.db, num volume)
HISTORICO_DB=data/eleicoes.db
# Cache das fotos oficiais dos candidatos
FOTOS_DIR=data/fotos
# Conexões "ao vivo" (SSE) simultâneas; acima disso o aparelho volta a consultar a cada CACHE_SEGUNDOS.
# Medido: ~5 mil conexões custam <100 MB de RAM; o aviso chega a todas em <50 ms.
MAX_CONEXOES=5000
