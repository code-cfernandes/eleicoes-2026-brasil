# ── Eleição ─────────────────────────────────────────────────────────────
# Ambiente: "oficial" (eleição real) ou "simulado/simulado2026" (testes do TSE)
TSE_BASE=https://resultados.tse.jus.br/oficial
CICLO=ele2026
# Códigos de eleição: deixe vazios e eles são descobertos sozinhos na lista do TSE
# (comum/config/ele-c.json): o 1º turno pelos cargos, o 2º pelo campo cdt2 do 1º. Preencha só
# para forçar um valor (vale o do ambiente; divergência com o TSE vira aviso no log).
# Com o 2º turno conhecido, ele vira o turno atual (o único coletado ao vivo) e o padrão da tela;
# o 1º fica arquivado e acessível pelo seletor "1º turno | 2º turno". Enquanto o TSE não publica
# os arquivos do 2º turno, a tela mostra os finalistas do 1º zerados. `npm run eleicoes` lista tudo.
INICIO_APURACAO=2026-10-04T17:00:00-03:00
ELEICAO_FEDERAL=
ELEICAO_ESTADUAL=
ELEICAO_FEDERAL_2T=
ELEICAO_ESTADUAL_2T=
INICIO_APURACAO_2T=2026-10-25T17:00:00-03:00

# ── Coleta ──────────────────────────────────────────────────────────────
# Intervalo de consulta ao TSE (o custo não cresce com o número de aparelhos)
CACHE_SEGUNDOS=30
# Disputas coletadas mesmo sem ninguém na tela. Formato uf:cargo, "*" = todos.
# Cargos: 1 presidente, 3 governador, 5 senador, 6 dep. federal, 7 dep. estadual, 8 dep. distrital
# Ex.: br:1,*:3,*:5 (presidente BR + governador e senador de todas as UFs)
MONITORAR=br:1,*:1,*:3

# ── Limites ─────────────────────────────────────────────────────────────
# Conexões ao vivo simultâneas; acima disso o aparelho volta a consultar a cada CACHE_SEGUNDOS
MAX_CONEXOES=5000
# Aparelhos inscritos em notificações
MAX_INSCRICOES=50000

# ── Notificações (PWA) ──────────────────────────────────────────────────
# Contato exigido pelos serviços de push (a Apple pode recusar sem um real): e-mail (vira mailto:) ou https://...
VAPID_CONTATO=
# Chaves VAPID: deixe em branco para gerar sozinhas e guardar no volume (data/vapid.json)
VAPID_PUBLICA=
VAPID_PRIVADA=

# ── IA (DeepSeek, opcional) ─────────────────────────────────────────────
# Sem chave, a linha do tempo usa só as frases-modelo do código. Com chave, os eventos de
# Presidente/Brasil têm o texto reescrito pela IA (neutro, só sobre os fatos detectados).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Mínimo de minutos entre duas chamadas à API (controla custo/latência)
IA_INTERVALO_MIN=15
# Minutos entre os balanços periódicos de Presidente/Brasil (notícia de andamento + aumento %)
NOTICIA_INTERVALO_MIN=5

# ── Porta ───────────────────────────────────────────────────────────────
# Porta publicada no host pelo Docker (dentro do container é sempre 3000)
PORTA_HOST=3000

# ── Só para rodar fora do Docker (npm start / npm run dev:api) ──────────
# No Docker/Portainer estes três são fixos no compose.yaml e podem ser ignorados
PORT=3000
HISTORICO_DB=data/eleicoes.db
FOTOS_DIR=data/fotos
