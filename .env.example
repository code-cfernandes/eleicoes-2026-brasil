# ── Eleição ─────────────────────────────────────────────────────────────
# Ambiente: "oficial" (eleição real) ou "simulado/simulado2026" (testes do TSE)
TSE_BASE=https://resultados.tse.jus.br/oficial
CICLO=ele2026
TURNO=1º turno
# Códigos do 1º turno de 2026. No 2º turno (25/10), troque: `npm run eleicoes` lista os códigos
ELEICAO_FEDERAL=6257
ELEICAO_ESTADUAL=6259

# ── Coleta ──────────────────────────────────────────────────────────────
# Intervalo de consulta ao TSE (o custo não cresce com o número de aparelhos)
CACHE_SEGUNDOS=30
# Disputas coletadas mesmo sem ninguém na tela. Formato uf:cargo, "*" = todos.
# Cargos: 1 presidente, 3 governador, 5 senador, 6 dep. federal, 7 dep. estadual, 8 dep. distrital
# Ex.: br:1,*:3,*:5 (presidente BR + governador e senador de todas as UFs)
MONITORAR=br:1

# ── Limites ─────────────────────────────────────────────────────────────
# Conexões ao vivo simultâneas; acima disso o aparelho volta a consultar a cada CACHE_SEGUNDOS
MAX_CONEXOES=5000
# Aparelhos inscritos em notificações
MAX_INSCRICOES=50000

# ── Notificações (PWA) ──────────────────────────────────────────────────
# Contato exigido pelos serviços de push (a Apple pode recusar sem um real): mailto:... ou https://...
VAPID_CONTATO=
# Chaves VAPID: deixe em branco para gerar sozinhas e guardar no volume (data/vapid.json)
VAPID_PUBLICA=
VAPID_PRIVADA=

# ── Porta ───────────────────────────────────────────────────────────────
# Porta publicada no host pelo Docker (dentro do container é sempre 3000)
PORTA_HOST=3000

# ── Só para rodar fora do Docker (npm start / npm run dev:api) ──────────
# No Docker/Portainer estes três são fixos no compose.yaml e podem ser ignorados
PORT=3000
HISTORICO_DB=data/eleicoes.db
FOTOS_DIR=data/fotos
